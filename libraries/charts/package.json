{
  "name": "@keel-libs/charts",
  "version": "0.1.0",
  "private": true,
  "description": "Bar charts, line charts and sparklines for Keel apps, drawn as SVG in a Host and readable as a table.",
  "type": "module",
  "keel": "library",
  "exports": {
    ".": {
      "keel": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["module.ts", "src", "dist", ".keel/ledger.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "keel check && keel pack --frozen",
    "test": "keel test",
    "prepack": "tsc -p tsconfig.build.json && keel pack --frozen"
  },
  "peerDependencies": {
    "@keel/compiler": "workspace:^",
    "@keel/reactive": "workspace:^",
    "@keel/runtime-dom": "workspace:^",
    "@keel/schema": "workspace:^",
    "@keel/ui": "workspace:^"
  },
  "devDependencies": {
    "@keel/cli": "workspace:*",
    "@keel/compiler": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/ui": "workspace:*",
    "@keel/testing": "workspace:*",
    "@types/node": "^22",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "fast-check": "^3"
  }
}
