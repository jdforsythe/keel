    "test": "node tooling/turbo.mjs test",
    "coverage": "node tooling/turbo.mjs coverage",
    "build": "node tooling/turbo.mjs build",
    "mutate": "node tooling/turbo.mjs mutate",
    "mutate:changed": "node tooling/mutate-changed.mjs",
    "mutate:stale": "node tooling/mutate-stale.mjs",
    "mutate:status": "node tooling/mutate.mjs --status",
    "mutate:stop": "node tooling/mutate.mjs --stop",
    "orphans": "node tooling/orphans.mjs",
    "eval": "tsx evals/run.ts",
    "eval:h2h": "tsx evals/h2h.ts",
    "eval:public": "tsx evals/public/main.ts",
    "spec": "node tooling/spec.mjs",
    "ledger": "node packages/cli/src/bin.ts ledger --write tooling/ledger/ledger.json",
    "evidence:report": "node tooling/evidence-report.mjs",
    "handoff": "node tooling/handoff.mjs",
    "gate": "node tooling/gate.mjs",
    "generate": "node tooling/generate.mjs",
    "docs:pack": "node tooling/docs-pack.mjs --all",
    "budgets": "node tooling/budgets.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
