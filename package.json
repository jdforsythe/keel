{
  "name": "keel",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "turbo run check --output-logs=errors-only && node tooling/structure-lint.mjs",
    "test": "turbo run test --output-logs=errors-only",
    "build": "turbo run build --output-logs=errors-only",
    "mutate": "turbo run mutate --output-logs=errors-only",
    "eval": "tsx evals/run.ts",
    "spec": "node tooling/spec.mjs",
    "ledger": "node tooling/ledger.mjs",
    "handoff": "node tooling/handoff.mjs"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.6",
    "@biomejs/biome": "^1.9",
    "vitest": "^2",
    "fast-check": "^3",
    "@playwright/test": "^1.48",
    "@stryker-mutator/core": "^8",
    "@changesets/cli": "^2",
    "tsx": "^4"
  }
}