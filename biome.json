{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsoleLog": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "files": {
    "ignore": [
      "turbo.json",
      ".github/**",
      "dist/**",
      ".worktrees/**",
      "coverage/**",
      "tooling/ledger/ledger.json",
      "**/test/.tmp-*/**",
      "**/conformance/.tmp-*/**",
      ".fixtures/**",
      "**/.keel/**",
      "packages/*/reports/**",
      "packages/*/docs/**",
      "apps/*/reports/**",
      "tooling/reports/**",
      "**/.stryker-tmp/**",
      "**/.turbo/**"
    ]
  }
}
