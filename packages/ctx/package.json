{
  "name": "@keel/ctx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal/index.ts",
      "default": "./src/internal/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./internal": {
        "types": "./dist/src/internal/index.d.ts",
        "default": "./dist/src/internal/index.js"
      },
      "./node": {
        "types": "./dist/src/node/index.d.ts",
        "default": "./dist/src/node/index.js"
      }
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@keel/tooling": "workspace:*"
  }
}
