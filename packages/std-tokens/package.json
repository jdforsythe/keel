{
  "name": "@keel/std-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs"
  },
  "dependencies": {
    "@keel/check": "workspace:*",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@keel/router": "workspace:*",
    "@keel/server": "workspace:*",
    "@keel/services": "workspace:*",
    "@keel/store": "workspace:*",
    "@keel/testing": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3"
  }
}
