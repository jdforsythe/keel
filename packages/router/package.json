{
  "name": "@keel/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "default": "./src/contract/index.ts"
    },
    "./match": {
      "types": "./src/match/index.ts",
      "default": "./src/match/index.ts"
    },
    "./internal": {
      "types": "./src/internal/index.ts",
      "default": "./src/internal/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./contract": {
        "types": "./dist/src/contract/index.d.ts",
        "default": "./dist/src/contract/index.js"
      },
      "./match": {
        "types": "./dist/src/match/index.d.ts",
        "default": "./dist/src/match/index.js"
      },
      "./internal": {
        "types": "./dist/src/internal/index.d.ts",
        "default": "./dist/src/internal/index.js"
      }
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@keel/compiler": "workspace:*",
    "@keel/tooling": "workspace:*",
    "fast-check": "^3"
  }
}
