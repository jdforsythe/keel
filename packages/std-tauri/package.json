{
  "name": "@keel/std-tauri",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shellMount": {
      "types": "./src/shellMount.ts",
      "default": "./src/shellMount.ts"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./shellMount": {
        "types": "./dist/src/shellMount.d.ts",
        "default": "./dist/src/shellMount.js"
      },
      "./package.json": "./package.json",
      "./tools": {
        "types": "./dist/src/tools/index.d.ts",
        "default": "./dist/src/tools/index.js"
      }
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/cli": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/router": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-http": "2.9.0",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-store": "2.5.1"
  },
  "peerDependencies": {
    "@tauri-apps/cli": "2.12.4"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@keel/scaffold": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/services": "workspace:*",
    "@keel/testing": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3"
  }
}
