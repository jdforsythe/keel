{
  "name": "@keel/std-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keel": "library",
  "exports": {
    ".": {
      "keel": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sqlite": {
      "keel": "./src/sqlite/index.server.ts",
      "types": "./src/sqlite/index.server.ts",
      "default": "./src/sqlite/index.server.ts"
    },
    "./postgres": {
      "keel": "./src/postgres/index.server.ts",
      "types": "./src/postgres/index.server.ts",
      "default": "./src/postgres/index.server.ts"
    },
    "./tools": {
      "keel": "./src/tools/index.ts",
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "keel": "./src/index.ts",
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./sqlite": {
        "keel": "./src/sqlite/index.server.ts",
        "types": "./dist/src/sqlite/index.server.d.ts",
        "default": "./dist/src/sqlite/index.server.js"
      },
      "./postgres": {
        "keel": "./src/postgres/index.server.ts",
        "types": "./dist/src/postgres/index.server.d.ts",
        "default": "./dist/src/postgres/index.server.js"
      },
      "./tools": {
        "keel": "./src/tools/index.ts",
        "types": "./dist/src/tools/index.d.ts",
        "default": "./dist/src/tools/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": ["module.ts", "src", "unsafe", "dist", ".keel/ledger.json", "docs", "README.md"],
  "scripts": {
    "check": "tsc --noEmit && biome check src unsafe test module.ts && keel check",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "tsc -p tsconfig.build.json && node ../../tooling/docs-pack.mjs && keel pack"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "@keel/check": "workspace:*",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@keel/check": "workspace:*",
    "@keel/cli": "workspace:*",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/router": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/server": "workspace:*",
    "@keel/store": "workspace:*",
    "@keel/testing": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "fast-check": "^3"
  }
}
