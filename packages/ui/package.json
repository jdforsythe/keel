{
  "name": "@keel/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": {
      "types": "./src/css/index.ts",
      "default": "./src/css/index.ts"
    },
    "./brand": {
      "types": "./src/brand/index.ts",
      "default": "./src/brand/index.ts"
    },
    "./aria": {
      "types": "./src/aria/index.ts",
      "default": "./src/aria/index.ts"
    },
    "./fonts": "./fonts/fonts.css"
  },
  "files": ["dist", "fonts", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/compiler": "workspace:*",
    "@keel/forms": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/router": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@keel/tooling": "workspace:*",
    "axe-core": "4.14.0"
  }
}
