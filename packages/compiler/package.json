{
  "name": "@keel/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./routes": {
      "types": "./src/buildRoutes.ts",
      "default": "./src/buildRoutes.ts"
    },
    "./internal": {
      "types": "./src/globals/index.ts",
      "default": "./src/globals/index.ts"
    },
    "./a11y": {
      "types": "./src/a11y/index.ts",
      "default": "./src/a11y/index.ts"
    },
    "./internal/entry/*": {
      "types": "./src/entry/*.ts",
      "default": "./src/entry/*.ts"
    },
    "./inspect/*": {
      "types": "./src/inspect/*.ts",
      "default": "./src/inspect/*.ts"
    },
    "./std/*": {
      "types": "./src/std/*.ts",
      "default": "./src/std/*.ts"
    },
    "./hosting/*": {
      "types": "./src/hosting/*.ts",
      "default": "./src/hosting/*.ts"
    },
    "./testing": {
      "types": "./src/testing/evaluate.ts",
      "default": "./src/testing/evaluate.ts"
    },
    "./tsconfig.strict.json": "./tsconfig.strict.json"
  },
  "files": ["dist", "tsconfig.strict.json", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.157.0"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "fast-check": "^3",
    "happy-dom": "^21.0.4"
  }
}
