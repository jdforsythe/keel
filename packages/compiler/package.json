{
  "name": "@keel/compiler",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./testing": {
      "types": "./src/testing/evaluate.ts",
      "default": "./src/testing/evaluate.ts"
    },
    "./tsconfig.strict.json": "./tsconfig.strict.json"
  },
  "files": [
    "dist",
    "tsconfig.strict.json"
  ],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "echo skip"
  },
  "dependencies": {
    "@keel/reactive": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.157.0"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "fast-check": "^3",
    "happy-dom": "^21.0.4"
  }
}
