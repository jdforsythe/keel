{
  "name": "@keel/std-geo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@keel/tooling": "workspace:*",
    "fast-check": "^3"
  }
}
