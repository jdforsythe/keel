{
  "name": "@keel/check",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./explain": {
      "types": "./src/explain.ts",
      "default": "./src/explain.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs"
  },
  "dependencies": {
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*",
    "@keel/ui": "workspace:*",
    "happy-dom": "^21.0.4",
    "oxc-parser": "^0.157.0",
    "typescript": "^5.6"
  },
  "devDependencies": {
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3"
  }
}
