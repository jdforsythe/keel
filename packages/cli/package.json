{
  "name": "@keel/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/respond.ts",
      "default": "./src/testing/respond.ts"
    },
    "./evidence": {
      "types": "./src/evidence/index.ts",
      "default": "./src/evidence/index.ts"
    },
    "./docs": {
      "types": "./src/docs/index.ts",
      "default": "./src/docs/index.ts"
    },
    "./review": {
      "types": "./src/review/index.ts",
      "default": "./src/review/index.ts"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "default": "./src/shell/index.ts"
    }
  },
  "bin": {
    "keel": "./src/bin.ts"
  },
  "publishConfig": {
    "bin": {
      "keel": "./dist/src/bin.js"
    }
  },
  "files": ["dist", "docs", "skills"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/check": "workspace:*",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/scaffold": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/services": "workspace:*",
    "@keel/testing": "workspace:*",
    "typescript": "^5.6",
    "vitest": "^4.1.12"
  },
  "devDependencies": {
    "@keel/reactive": "workspace:*",
    "@keel/router": "workspace:*",
    "@keel/server": "workspace:*",
    "@keel/store": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3"
  }
}
