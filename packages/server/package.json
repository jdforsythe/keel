{
  "name": "@keel/server",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal/start": {
      "types": "./src/internal/start.ts",
      "default": "./src/internal/start.ts"
    },
    "./internal/onUncaught": {
      "types": "./src/internal/onUncaught.ts",
      "default": "./src/internal/onUncaught.ts"
    },
    "./internal/dom": {
      "types": "./src/internal/dom/index.ts",
      "default": "./src/internal/dom/index.ts"
    },
    "./csp": {
      "types": "./src/csp/index.ts",
      "default": "./src/csp/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/router": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@keel/testing": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@keel/ui": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3",
    "happy-dom": "^21"
  }
}
