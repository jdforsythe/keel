{
  "name": "@keel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal/start": {
      "types": "./src/internal/start.ts",
      "default": "./src/internal/start.ts"
    },
    "./internal/startFailed": {
      "types": "./src/internal/startFailed.ts",
      "default": "./src/internal/startFailed.ts"
    },
    "./internal/prerender": {
      "types": "./src/internal/prerender.ts",
      "default": "./src/internal/prerender.ts"
    },
    "./internal/onUncaught": {
      "types": "./src/internal/onUncaught.ts",
      "default": "./src/internal/onUncaught.ts"
    },
    "./internal/dom": {
      "types": "./src/internal/dom/index.ts",
      "default": "./src/internal/dom/index.ts"
    },
    "./csp": {
      "types": "./src/csp/index.ts",
      "default": "./src/csp/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./internal/start": {
        "types": "./dist/src/internal/start.d.ts",
        "default": "./dist/src/internal/start.js"
      },
      "./internal/startFailed": {
        "types": "./dist/src/internal/startFailed.d.ts",
        "default": "./dist/src/internal/startFailed.js"
      },
      "./internal/prerender": {
        "types": "./dist/src/internal/prerender.d.ts",
        "default": "./dist/src/internal/prerender.js"
      },
      "./internal/onUncaught": {
        "types": "./dist/src/internal/onUncaught.d.ts",
        "default": "./dist/src/internal/onUncaught.js"
      },
      "./internal/dom": {
        "types": "./dist/src/internal/dom/index.d.ts",
        "default": "./dist/src/internal/dom/index.js"
      },
      "./csp": {
        "types": "./dist/src/csp/index.d.ts",
        "default": "./dist/src/csp/index.js"
      }
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@keel/compiler": "workspace:*",
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/router": "workspace:*",
    "@keel/runtime-dom": "workspace:*",
    "@keel/schema": "workspace:*",
    "@keel/store": "workspace:*",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@keel/forms": "workspace:*",
    "@keel/testing": "workspace:*",
    "@keel/tooling": "workspace:*",
    "@keel/ui": "workspace:*",
    "@types/node": "^22",
    "fast-check": "^3",
    "happy-dom": "^21"
  }
}
