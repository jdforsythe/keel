{
  "name": "@keel/runtime-dom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["./src/ops/resume.ts"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ops": {
      "types": "./src/ops/index.ts",
      "default": "./src/ops/index.ts"
    },
    "./internal": {
      "types": "./src/internal/index.ts",
      "default": "./src/internal/index.ts"
    },
    "./url": {
      "types": "./src/url/index.ts",
      "default": "./src/url/index.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    }
  },
  "files": ["dist", "jsx-runtime.d.ts", "docs"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "coverage": "node ../../tooling/coverage.mjs",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs",
    "prepack": "node ../../tooling/docs-pack.mjs"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@keel/store": "workspace:*",
    "@keel/tooling": "workspace:*"
  }
}
