{
  "name": "@keel/runtime-dom",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": ["./src/ops/resume.ts"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ops": {
      "types": "./src/ops/index.ts",
      "default": "./src/ops/index.ts"
    },
    "./internal/safeUrl": {
      "types": "./src/internal/safeUrl.ts",
      "default": "./src/internal/safeUrl.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    }
  },
  "files": ["dist", "jsx-runtime.d.ts"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "echo skip"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/reactive": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@keel/tooling": "workspace:*"
  }
}
