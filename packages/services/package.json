{
  "name": "@keel/services",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi": {
      "types": "./src/openapi/index.ts",
      "default": "./src/openapi/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check": "tsc --noEmit && biome check src test unsafe",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "mutate": "node ../../tooling/mutate.mjs"
  },
  "dependencies": {
    "@keel/ctx": "workspace:*",
    "@keel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@keel/check": "workspace:*",
    "@keel/tooling": "workspace:*",
    "fast-check": "^3"
  }
}
