{
  "$comment": "The ordinary test suite on macOS, split into the shards of the Linux test-shard job (node tooling/ci-shards.mjs <n>, the shard count is that job's matrix). It runs weekly, on Mondays at 06:00 UTC, from the default branch, and on workflow_dispatch.",
  "name": "test-macos",
  "on": {
    "schedule": [
      {
        "cron": "0 6 * * 1"
      }
    ],
    "workflow_dispatch": {}
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "test-macos-${{ github.ref }}",
    "cancel-in-progress": true
  },
  "env": {
    "KEEL_AGENT": "1"
  },
  "setup": [
    {
      "uses": "actions/checkout@v4",
      "with": {
        "fetch-depth": 0
      }
    },
    {
      "uses": "pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1"
    },
    {
      "uses": "actions/setup-node@v4",
      "with": {
        "node-version": 22,
        "cache": "pnpm"
      }
    },
    {
      "run": "pnpm install --frozen-lockfile"
    }
  ],
  "jobs": {
    "test-macos": {
      "if": "github.event.repository.private == false",
      "runs-on": "macos-26",
      "timeout-minutes": 60,
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "shard": [1, 2, 3, 4, 5, 6]
        }
      },
      "steps": [
        "$setup",
        {
          "run": "node tooling/ci-shards.mjs ${{ matrix.shard }}"
        }
      ]
    }
  }
}
