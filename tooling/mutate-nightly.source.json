{
  "$comment": "Mutation for every package that has a Stryker config, one package per job; @keel/check runs as the shards of `mutate-check` (tooling/mutate-shard.mjs), each over its slice of check's files. A package's incremental file (<git common dir>/keel-mutation/<pkg>.json) is restored from the newest cache entry of that package, or of that shard, and saved again at the end, so a night that stops at the 30-minute budget (tooling/budgets.json) is continued by the next one. The ledger job merges check's shard reports into packages/check/reports/mutation/mutation.json before `pnpm ledger`. A scheduled workflow runs only from the default branch's copy of this file.",
  "name": "mutate-nightly",
  "on": {
    "schedule": [
      {
        "cron": "0 3 * * *"
      }
    ],
    "workflow_dispatch": {}
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "mutate-nightly",
    "cancel-in-progress": false
  },
  "env": {
    "KEEL_AGENT": "1"
  },
  "setup": [
    {
      "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0",
      "with": {
        "fetch-depth": 0
      }
    },
    {
      "uses": "pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1"
    },
    {
      "uses": "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0",
      "with": {
        "node-version": 22,
        "cache": "pnpm"
      }
    },
    {
      "run": "pnpm install --frozen-lockfile"
    }
  ],
  "jobs": {
    "mutate": {
      "if": "github.ref == 'refs/heads/master'",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 60,
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "package": [
            "cli",
            "compiler",
            "ctx",
            "forms",
            "reactive",
            "router",
            "runtime-dom",
            "scaffold",
            "schema",
            "server",
            "services",
            "std-brands",
            "std-capacitor",
            "std-channels",
            "std-conflicts",
            "std-db",
            "std-geo",
            "std-headless",
            "std-health",
            "std-i18n",
            "std-jobs",
            "std-live",
            "std-messages",
            "std-money",
            "std-offline",
            "std-postgres",
            "std-report",
            "std-schedules",
            "std-sessions",
            "std-statecharts",
            "std-tables",
            "std-tauri",
            "std-temporal",
            "std-text",
            "std-timings",
            "std-tokens",
            "std-workflows",
            "store",
            "testing",
            "ui"
          ]
        }
      },
      "steps": [
        "$setup",
        {
          "uses": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ matrix.package }}-${{ github.run_id }}-${{ github.run_attempt }}",
            "restore-keys": "stryker-${{ matrix.package }}-"
          }
        },
        {
          "run": "pnpm --filter ./packages/${{ matrix.package }} mutate"
        },
        {
          "if": "always()",
          "uses": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ matrix.package }}-${{ github.run_id }}-${{ github.run_attempt }}"
          }
        },
        {
          "if": "always()",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2",
          "with": {
            "name": "mutation-${{ matrix.package }}",
            "path": "packages/${{ matrix.package }}/reports/mutation/mutation.json",
            "if-no-files-found": "ignore",
            "retention-days": 7
          }
        }
      ]
    },
    "mutate-check": {
      "if": "github.ref == 'refs/heads/master'",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 60,
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "shard": [1, 2, 3, 4, 5, 6, 7, 8]
        }
      },
      "steps": [
        "$setup",
        {
          "uses": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-check-shard-${{ matrix.shard }}-of-${{ strategy.job-total }}-${{ github.run_id }}-${{ github.run_attempt }}",
            "restore-keys": "stryker-check-shard-${{ matrix.shard }}-of-${{ strategy.job-total }}-\nstryker-check-"
          }
        },
        {
          "run": "pnpm --filter ./packages/check mutate --shard ${{ matrix.shard }}/${{ strategy.job-total }}"
        },
        {
          "if": "always()",
          "uses": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-check-shard-${{ matrix.shard }}-of-${{ strategy.job-total }}-${{ github.run_id }}-${{ github.run_attempt }}"
          }
        },
        {
          "if": "always()",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2",
          "with": {
            "name": "check-shard-${{ matrix.shard }}-of-${{ strategy.job-total }}",
            "path": "packages/check/reports/mutation/mutation.json",
            "if-no-files-found": "ignore",
            "retention-days": 7
          }
        }
      ]
    },
    "ledger": {
      "if": "!cancelled() && github.ref == 'refs/heads/master'",
      "needs": ["mutate", "mutate-check"],
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 75,
      "steps": [
        "$setup",
        {
          "uses": "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0",
          "with": {
            "pattern": "mutation-*",
            "path": "mutation-reports"
          }
        },
        {
          "name": "put each package's report where the ledger reads it",
          "run": "for d in mutation-reports/mutation-*; do pkg=\"${d##*/mutation-}\"; mkdir -p \"packages/$pkg/reports/mutation\"; cp \"$d/mutation.json\" \"packages/$pkg/reports/mutation/\"; done"
        },
        {
          "uses": "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0",
          "with": {
            "pattern": "check-shard-*",
            "path": "check-shards"
          }
        },
        {
          "name": "merge check's shard reports into the one report the ledger reads",
          "run": "node tooling/mutate-shard.mjs merge packages/check/reports/mutation/mutation.json check-shards"
        },
        {
          "name": "every justified survivor still matches a survivor of its package's report",
          "run": "node tooling/mutate-justified.mjs"
        },
        {
          "name": "run reports for the ledger: every project's tests (pnpm test writes reports/tests/*.json)",
          "run": "pnpm test"
        },
        {
          "name": "a11y reports for the ledger from every app and example whose routes it carries (keel test writes reports/a11y.json)",
          "run": "pnpm --workspace-concurrency=1 --filter golden-1 --filter golden-2 --filter household --filter \"./examples/*\" exec keel test"
        },
        {
          "run": "pnpm ledger"
        },
        {
          "run": "pnpm ledger --diff"
        }
      ]
    }
  }
}
