{
  "name": "ci",
  "on": {
    "push": {
      "branches": ["main"]
    },
    "pull_request": {},
    "schedule": [
      {
        "cron": "0 3 * * *"
      },
      {
        "cron": "0 4 * * 1"
      }
    ]
  },
  "env": {
    "KEEL_AGENT": "1",
    "TURBO_TOKEN": "${{ secrets.TURBO_TOKEN }}",
    "TURBO_TEAM": "${{ vars.TURBO_TEAM }}"
  },
  "setup": [
    {
      "uses": "actions/checkout@v4",
      "with": {
        "fetch-depth": 0
      }
    },
    {
      "uses": "pnpm/action-setup@v4"
    },
    {
      "uses": "actions/setup-node@v4",
      "with": {
        "node-version": 22,
        "cache": "pnpm"
      }
    },
    {
      "run": "pnpm install --frozen-lockfile"
    }
  ],
  "jobs": {
    "check": {
      "if": "github.event_name != 'schedule'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm check"
        }
      ]
    },
    "test": {
      "needs": "check",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm test"
        }
      ]
    },
    "build": {
      "needs": "test",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm build"
        }
      ]
    },
    "budgets": {
      "needs": "build",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm build"
        },
        {
          "run": "node tooling/budgets.mjs"
        }
      ]
    },
    "ledger": {
      "needs": "budgets",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm ledger --diff"
        }
      ]
    },
    "mutate-pr": {
      "if": "github.event_name == 'pull_request'",
      "needs": "test",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "uses": "actions/cache@v4",
          "with": {
            "path": "packages/*/.stryker-tmp/incremental.json",
            "key": "stryker-${{ github.base_ref || 'main' }}-${{ github.sha }}",
            "restore-keys": "stryker-${{ github.base_ref || 'main' }}-\nstryker-main-"
          }
        },
        {
          "run": "node tooling/mutate-changed.mjs"
        }
      ]
    },
    "mutate": {
      "if": "github.event_name == 'schedule' && github.event.schedule == '0 3 * * *'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "uses": "actions/cache@v4",
          "with": {
            "path": "packages/*/.stryker-tmp/incremental.json",
            "key": "stryker-${{ github.base_ref || 'main' }}-${{ github.sha }}",
            "restore-keys": "stryker-${{ github.base_ref || 'main' }}-\nstryker-main-"
          }
        },
        {
          "run": "pnpm mutate --filter=\"./packages/*\""
        }
      ]
    },
    "eval": {
      "if": "github.event_name == 'schedule' && github.event.schedule == '0 4 * * 1'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm eval --runner=none"
        }
      ]
    }
  }
}
