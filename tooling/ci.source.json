{
  "name": "ci",
  "on": {
    "push": {
      "branches": ["master"]
    },
    "pull_request": {},
    "schedule": [
      {
        "cron": "0 3 * * *"
      },
      {
        "cron": "0 4 * * 1"
      }
    ]
  },
  "concurrency": {
    "group": "ci-${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}",
    "cancel-in-progress": true
  },
  "env": {
    "KEEL_AGENT": "1",
    "TURBO_TOKEN": "${{ secrets.TURBO_TOKEN }}",
    "TURBO_TEAM": "${{ vars.TURBO_TEAM }}"
  },
  "setup": [
    {
      "uses": "actions/checkout@v4",
      "with": {
        "fetch-depth": 0
      }
    },
    {
      "uses": "pnpm/action-setup@v4"
    },
    {
      "uses": "actions/setup-node@v4",
      "with": {
        "node-version": 22,
        "cache": "pnpm"
      }
    },
    {
      "run": "pnpm install --frozen-lockfile"
    }
  ],
  "jobs": {
    "check": {
      "if": "github.event_name != 'schedule'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm check"
        }
      ]
    },
    "test": {
      "needs": "check",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm test"
        }
      ]
    },
    "postgres": {
      "needs": "check",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 15,
      "services": {
        "postgres": {
          "image": "postgres:17",
          "env": {
            "POSTGRES_PASSWORD": "keel-ci-throwaway"
          },
          "ports": ["5432:5432"],
          "options": "--health-cmd pg_isready --health-interval 2s --health-timeout 5s --health-retries 30"
        }
      },
      "env": {
        "KEEL_TEST_POSTGRES_URL": "postgres://postgres:keel-ci-throwaway@127.0.0.1:5432/postgres"
      },
      "steps": [
        "$setup",
        {
          "name": "std-db files that take KEEL_TEST_POSTGRES_URL, one at a time on one database",
          "working-directory": "packages/std-db",
          "run": "set -e\nfor f in conformance/driver-contract.test.ts conformance/serial-commits.test.ts conformance/layout-e2152.test.ts conformance/e2153-no-value.test.ts test/model.test.ts test/postgres-server.test.ts; do pnpm exec vitest run \"$f\"; done"
        }
      ]
    },
    "build": {
      "needs": "test",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm build"
        }
      ]
    },
    "budgets": {
      "needs": "build",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm build"
        },
        {
          "run": "node tooling/budgets.mjs"
        }
      ]
    },
    "ledger": {
      "needs": "budgets",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm ledger --diff"
        }
      ]
    },
    "golden-1-images": {
      "needs": "build",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm build"
        },
        {
          "name": "docker build per node deployable, never pushed",
          "run": "for f in apps/golden-1/deploy/*/Dockerfile; do n=$(basename \"$(dirname \"$f\")\"); docker build -f \"$f\" -t \"golden-1-$n\" apps/golden-1; done"
        }
      ]
    },
    "mutate-pr": {
      "if": "github.event_name == 'pull_request'",
      "needs": "test",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "uses": "actions/cache/restore@v4",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}",
            "restore-keys": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-\nstryker-${{ github.base_ref || 'master' }}-\nstryker-master-"
          }
        },
        {
          "run": "node tooling/mutate-changed.mjs"
        },
        {
          "run": "pnpm ledger --diff"
        },
        {
          "if": "always()",
          "uses": "actions/cache/save@v4",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}"
          }
        }
      ]
    },
    "mutate": {
      "if": "github.event_name == 'schedule' && github.event.schedule == '0 3 * * *'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "uses": "actions/cache/restore@v4",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}",
            "restore-keys": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-\nstryker-${{ github.base_ref || 'master' }}-\nstryker-master-"
          }
        },
        {
          "run": "pnpm mutate --filter=\"./packages/*\""
        },
        {
          "run": "pnpm ledger --diff"
        },
        {
          "if": "always()",
          "uses": "actions/cache/save@v4",
          "with": {
            "path": ".git/keel-mutation",
            "key": "stryker-${{ github.base_ref || 'master' }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}"
          }
        }
      ]
    },
    "eval": {
      "if": "github.event_name == 'schedule' && github.event.schedule == '0 4 * * 1'",
      "runs-on": "ubuntu-latest",
      "steps": [
        "$setup",
        {
          "run": "pnpm eval --runner=none"
        }
      ]
    }
  }
}
