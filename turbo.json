{
  "$schema": "https://turbo.build/schema.json",
  "_generated": "edit tooling/turbo.source.json and run pnpm scaffold turbo",
  "tasks": {
    "check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "mutate": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "reports/**"
      ]
    }
  }
}