{
  "openapi": "3.0.3",
  "info": { "title": "Quotes", "version": "1.0.0" },
  "servers": [{ "url": "http://localhost:4417" }],
  "paths": {
    "/quotes/{id}": {
      "get": {
        "operationId": "getQuote",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "One quote",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quote" } } }
          },
          "404": {
            "description": "No such quote",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Missing" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Quote": {
        "type": "object",
        "required": ["id", "text", "author"],
        "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "author": { "type": "string" } }
      },
      "Missing": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } }
    }
  }
}
